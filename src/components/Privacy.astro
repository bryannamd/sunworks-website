---
import Base from '../layouts/Base.astro';
import RichText from './RichText.astro';
import { copy, type Lang, type PrivacyCopy } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t: PrivacyCopy = copy[lang].privacy;
const alternates = [
  ...(['ko', 'en'] as const).map((l) => ({
    hreflang: l,
    href: copy[l].privacy.path,
  })),
  { hreflang: 'x-default', href: copy.ko.privacy.path },
];
---

<Base
  lang={lang}
  title={t.metaTitle}
  description={t.description}
  alternates={alternates}
>
  <main id="main" class="privacy">
    <a class="text-link" href={copy[lang].path}>
      {t.homeLabel}
    </a>
    <h1>{t.title}</h1>
    <p class="effective">{t.effective}</p>
    <p class="intro">
      <RichText value={t.intro} />
    </p>
    {t.sections.map((s) => (
      <section>
        <h2>{s.title}</h2>
        {s.body && (
          <p>
            <RichText value={s.body} />
          </p>
        )}
        {s.items && (
          <dl>
            {s.items.map((i) => (
              <div>
                <dt>{i.dt}</dt>
                <dd>
                  <RichText value={i.dd} />
                </dd>
              </div>
            ))}
          </dl>
        )}
        {s.note && (
          <p>
            <RichText value={s.note} />
          </p>
        )}
      </section>
    ))}
  </main>
</Base>
